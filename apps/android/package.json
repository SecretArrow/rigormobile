{
  "name": "@rigormobile/android",
  "version": "0.1.0",
  "private": true,
  "description": "RigorChain GPU miner for Android — Expo + React Native + native OpenCL module",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:aab": "expo prebuild --platform android --clean && cd android && ./gradlew bundleRelease",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf .expo android ios .turbo coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@rigormobile/rigor-core": "workspace:*",
    "@shopify/flash-list": "1.7.0",
    "expo": "~52.0.0",
    "expo-background-fetch": "~13.0.0",
    "expo-build-properties": "~0.13.0",
    "expo-clipboard": "~7.0.0",
    "expo-crypto": "~13.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-haptics": "~14.0.0",
    "expo-keep-awake": "~13.0.0",
    "expo-localization": "~16.0.0",
    "expo-notifications": "~0.28.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.0",
    "js-sha3": "^0.9.3",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-background-actions": "^4.0.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-vector-icons": "^10.2.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.2"
  }
}
