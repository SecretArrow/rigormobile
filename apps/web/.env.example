# RigorMobile web app — environment variables.
# Copy to .env and edit. NEVER commit your real .env.

# SQLite path for Prisma (server-side only; the wallet itself is in localStorage).
DATABASE_URL="file:./db/rigormobile.db"

# Optional: connect the web miner to a local RIGOR node.
# Leave empty to run in demo mode (synthetic block template).
RIGOR_RPC_URL=""
RIGOR_RPC_USER=""
RIGOR_RPC_PASS=""
